+class transformed_belief_commands(transformed_commands_v4):
+    """Per-agent *belief* of the box command, transformed into the agent's contact frame.
+
+    Reads the team mean and the divergence from a :class:`ConsensusVelocityHeightCommand` term and
+    returns ``mean + belief_sign * divergence`` before applying the same frame transform as
+    :class:`transformed_commands_v4`. Use ``belief_sign=+1`` for agent 0, ``-1`` for agent 1, and
+    ``0`` for the (centralized) critic so it sees the true mean.
+    """
+
+    def __init__(self, cfg: ObservationTermCfg, env: ManagerBasedEnv):
+        super().__init__(cfg, env)
+        self._belief_sign = float(cfg.params.get("belief_sign", 1.0))
+
+    def _fetch_command(self, env: ManagerBasedRLEnv, command_name: str) -> torch.Tensor:
+        term = env.command_manager.get_term(command_name)
+        # term.command is the team mean; term.divergence_b is the per-env divergence.
+        # Returns a fresh tensor, so downstream in-place ops never mutate the command buffer.
+        return term.command + self._belief_sign * term.divergence_b
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        command_name: str,
+        asset_cfg: SceneEntityCfg,
+        frame_cfg: SceneEntityCfg,
+        target_frame_name: str,
+        belief_sign: float = 1.0,
+        burn_in_time: float | None = None,
+        clip_range: dict[str, tuple[float, float]] | None = None,
+        dead_zone_velocity_threshold: float | None = None,
+    ) -> torch.Tensor:
+        self._belief_sign = float(belief_sign)
+        return super().__call__(
+            env,
+            command_name,
+            asset_cfg,
+            frame_cfg,
+            target_frame_name,
+            burn_in_time=burn_in_time,
+            clip_range=clip_range,
+            dead_zone_velocity_threshold=dead_zone_velocity_threshold,
+        )
+
+
+def partner_pose_b(
+    env: ManagerBasedEnv,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    partner_asset_cfg: SceneEntityCfg = SceneEntityCfg("robot_1"),
+    make_quat_unique: bool = True,
+) -> torch.Tensor:
+    """The partner's base pose expressed in this agent's base frame.
+
+    Returns a (num_envs, 7) tensor: relative position (xyz) followed by relative orientation
+    (quaternion wxyz). This is the "look at the partner's current pose" sensing channel.
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    partner: Articulation = env.scene[partner_asset_cfg.name]
+
+    self_pos_w = asset.data.root_pos_w
+    self_quat_w = asset.data.root_quat_w
+    partner_pos_w = partner.data.root_pos_w
+    partner_quat_w = partner.data.root_quat_w
+
+    rel_pos_b = math_utils.quat_apply_inverse(self_quat_w, partner_pos_w - self_pos_w)
+    rel_quat = math_utils.quat_mul(math_utils.quat_inv(self_quat_w), partner_quat_w)
+    if make_quat_unique:
+        rel_quat = math_utils.quat_unique(rel_quat)
+
+    return torch.cat([rel_pos_b, rel_quat], dim=-1)
+
+
